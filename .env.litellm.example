# Copy to .env.litellm on the proxy host. Generate three different secrets.
# LITELLM_MASTER_KEY and LITELLM_SALT_KEY must never be handed to clients.
LITELLM_MASTER_KEY=sk-replace-with-random-value
LITELLM_SALT_KEY=sk-replace-with-another-random-value
LITELLM_DB_PASSWORD=replace-with-random-hex
# Generated by litellm-init-env.py from the same database password.
LITELLM_DATABASE_URL=

# New client key. LiteLLM requires virtual keys to start with sk-.
# The old hex-only PROXY_API_KEY cannot be reused as a LiteLLM virtual key.
PROXY_API_KEY=sk-replace-with-new-random-client-key
CLAUDE_CODE_PROXY_KEY=sk-replace-with-a-different-random-client-key
LITELLM_RPM_LIMIT=120
LITELLM_TPM_LIMIT=1000000

# Stage on 4000, then switch to 3456 after the old service stops.
LITELLM_HOST_PORT=4000
CHATGPT_TOKEN_DIR=./.litellm/chatgpt
# Set to 1 only after the main-branch deploy workflow handles LiteLLM.
LITELLM_DEPLOY_WORKFLOW_READY=0

# Optional. Without this, Claude is available only to Claude Code users
# forwarding their own subscription OAuth token.
ANTHROPIC_API_KEY=
